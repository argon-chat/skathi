{
  // Needs this app's own node_modules: `bun install` here, then `bun x vue-tsc --noEmit -p .`.
  // Unlike apps/tsconfig.json this checks ported browser code (shadcn-vue, verbatim) as browser code.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM: reka-ui, vueuse and lucide are written against HTMLElement and friends.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"],
      // Not runtime.ts: it re-exports only @vue/runtime-core (no HTMLAttributes), and `paths` would retarget
      // reka-ui's own .d.ts imports of "vue".
      "@skathi-native/runtime": ["./node_modules/vue"]
    },
    "types": []
  },
  // checkUnknownProps/Events are off: shadcn forwards undeclared attrs through $attrs and reka-ui's Primitive.
  "vueCompilerOptions": {
    "strictTemplates": true,
    "checkUnknownProps": false,
    "checkUnknownEvents": false
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
