{
  // `bun run typecheck` at the repo root checks this with vue-tsc.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // No "DOM": the apps run on redjs. env.d.ts declares the subset it ships; add names there, never widen `lib`.
    "lib": ["ESNext"],
    "useDefineForClassFields": false,

    // The apps have no node_modules of their own: build.ts pre-seeds these bare specifiers into the loader's
    // registry, and these paths mirror that mapping.
    "baseUrl": ".",
    "paths": {
      "vue": ["../packages/runtime/src/runtime.ts"],
      "@skathi-native/runtime": ["../packages/runtime/src/runtime.ts"],
      "vue-router": ["../node_modules/vue-router"],
      "pinia": ["../node_modules/pinia"]
    },
    "types": []
  },
  // Not "vue": the hoisted node_modules/vue would pull @vue/runtime-dom into the template types.
  "vueCompilerOptions": { "lib": "@skathi-native/runtime" },
  "include": [
    // Ambient declarations are not pulled in by importing `@skathi-native/runtime`.
    "../packages/runtime/src/engine.d.ts",
    "../packages/runtime/src/protocol.d.ts",
    "../packages/runtime/src/indexeddb.d.ts",
    "../packages/runtime/env.d.ts",
    "hello/src/**/*.ts",
    "hello/src/**/*.vue",
    "oschrome/src/**/*.ts",
    "oschrome/src/**/*.vue",
    "imgperf/src/**/*.ts",
    "imgperf/src/**/*.vue",
    "shaderlab/src/**/*.ts",
    "shaderlab/src/**/*.vue",
    "popout/src/**/*.ts",
    "popout/src/**/*.vue",
    "listperf/src/**/*.ts",
    "listperf/src/**/*.vue",
    "../benches/*/app/src/**/*.ts",
    "../benches/*/app/src/**/*.vue",
    "devtools/src/**/*.ts",
    "devtools/src/**/*.vue",
    "../packages/test/fixtures/*/src/**/*.ts",
    "../packages/test/fixtures/*/src/**/*.vue",
    "../packages/cli/templates/*/src/**/*.ts",
    "../packages/cli/templates/*/src/**/*.vue"
  ]
}
