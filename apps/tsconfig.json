{
  // Type-check only (nothing emits):
  //   bun x vue-tsc --noEmit -p apps/tsconfig.json
  // Not extending packages/vue-native/tsconfig.json: its `include` is the runtime's own src/**.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",

    // No "DOM": the apps run on redjs, which ships a small subset of the web platform. env.d.ts
    // declares that subset; add missing names there, never widen `lib`.
    "lib": ["ESNext"],

    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,

    // Keeps a bare `x: T` field declaration erased; bun reads this key too.
    "useDefineForClassFields": false,

    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,

    // The apps have no node_modules of their own: build.ts pre-seeds these bare specifiers into the
    // loader's registry, and these paths mirror that mapping.
    "baseUrl": ".",
    "paths": {
      // Both names are one module: runtime.ts re-exports @vue/runtime-core.
      "vue": ["../packages/vue-native/src/runtime.ts"],
      "vue-native": ["../packages/vue-native/src/runtime.ts"],
      "vue-router": ["../packages/vue-native/node_modules/vue-router"],
      "pinia": ["../packages/vue-native/node_modules/pinia"]
    },

    // No @types package may put a browser or Node global in scope.
    "types": []
  },
  "include": [
    // Ambient declarations are not pulled in by importing `vue-native`; they must be listed.
    "../packages/vue-native/src/engine.d.ts",
    "../packages/vue-native/src/protocol.d.ts",
    "../packages/vue-native/src/indexeddb.d.ts",
    "env.d.ts",
    "hello/src/**/*.ts",
    "hello/src/**/*.vue",
    "oschrome/src/**/*.ts",
    "oschrome/src/**/*.vue",
    "imgperf/src/**/*.ts",
    "imgperf/src/**/*.vue",
    "shaderlab/src/**/*.ts",
    "shaderlab/src/**/*.vue",
    "popout/src/**/*.ts",
    "popout/src/**/*.vue",
    "devtools/src/**/*.ts",
    "devtools/src/**/*.vue"
  ]
  // hello/tailwind.config.ts is out of scope: a build-time Node module (needs @types/node).
}
