{
  // `bun run typecheck` in packages/vue-native checks this with vue-tsc.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // No "DOM": the apps run on redjs. env.d.ts declares the subset it ships; add names there, never widen `lib`.
    "lib": ["ESNext"],
    "useDefineForClassFields": false,

    // The apps have no node_modules of their own: build.ts pre-seeds these bare specifiers into the loader's
    // registry, and these paths mirror that mapping.
    "baseUrl": ".",
    "paths": {
      "vue": ["../packages/vue-native/src/runtime.ts"],
      "vue-native": ["../packages/vue-native/src/runtime.ts"],
      "vue-router": ["../packages/vue-native/node_modules/vue-router"],
      "pinia": ["../packages/vue-native/node_modules/pinia"]
    },
    "types": []
  },
  "include": [
    // Ambient declarations are not pulled in by importing `vue-native`.
    "../packages/vue-native/src/engine.d.ts",
    "../packages/vue-native/src/protocol.d.ts",
    "../packages/vue-native/src/indexeddb.d.ts",
    "env.d.ts",
    "hello/src/**/*.ts",
    "hello/src/**/*.vue",
    "oschrome/src/**/*.ts",
    "oschrome/src/**/*.vue",
    "imgperf/src/**/*.ts",
    "imgperf/src/**/*.vue",
    "shaderlab/src/**/*.ts",
    "shaderlab/src/**/*.vue",
    "popout/src/**/*.ts",
    "popout/src/**/*.vue",
    "listperf/src/**/*.ts",
    "listperf/src/**/*.vue",
    "devtools/src/**/*.ts",
    "devtools/src/**/*.vue",
    "../packages/vn-test/fixtures/*/src/**/*.ts",
    "../packages/vn-test/fixtures/*/src/**/*.vue"
  ]
}
