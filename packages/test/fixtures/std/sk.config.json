{
  "name": "sk-test-std",
  "version": "4.5.6",

  "permissions": {
    "ffi": [
      {
        "name": "crt",
        "path": { "windows": "$SYSTEM/msvcrt", "macos": "$SYSTEM/libSystem.B.dylib", "linux": "$SYSTEM/libc.so.6" }
