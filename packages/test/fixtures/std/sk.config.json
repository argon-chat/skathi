      { "name": "kernel32", "path": { "windows": "$SYSTEM/kernel32" } },
      { "name": "user32", "path": { "windows": "$SYSTEM/user32" } },
      { "name": "ucrt", "path": { "windows": "$SYSTEM/ucrtbase" } }
    ]
  },

  "window": {
    "title": "Skathi — skathi:* modules (fixture)",
    "width": 420,
    "height": 300
  }
}
