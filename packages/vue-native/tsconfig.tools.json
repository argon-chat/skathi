{
  // The BUILD-TIME half of this package: the builder scripts at the root
  // (build.ts, prod.ts, tailwind.ts, shaders.ts, fetch-slang.ts) and the
  // devtools clients. A separate program from tsconfig.json's, because it is a
  // separate WORLD: these run under bun with the full Node surface, while
  // `src/` runs inside JavaScriptCore with the deliberately small surface
  // `src/engine.d.ts` declares. The two cannot share one program — `@types/bun`
  // and `engine.d.ts` both declare `console`, `Event` and the timers, and one
  // `declare var` per name is the limit.
  //
  // `test/` is NOT here. Those files are TypeScript and `bun test` runs them,
  // but a strict pass over them needs the three harnesses' `new Function`
  // boundary to be given a hand-written return type first — see
  // research/reports/m20/runtime-ts.md, "what is not type-checked yet".
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "isolatedModules": true,
    "noImplicitOverride": true,
    "types": ["bun"]
  },
  "include": ["*.ts", "devtools/**/*.ts", "scripts/**/*.ts", "cli/**/*.ts"]
}
