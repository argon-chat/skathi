{
  // The build-time half: builders, the CLI, devtools clients and repo scripts, which run under bun.
  // Separate from tsconfig.json because @types/bun and src/engine.d.ts both declare `console`, `Event`
  // and the timers.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": false,
    "types": ["bun"]
  },
  "include": [
    "*.ts",
    "devtools/**/*.ts",
    "scripts/**/*.ts",
    "cli/**/*.ts",
    "../../scripts/**/*.ts",
    "../../crates/*/tools/**/*.ts"
  ]
}
