{
  // The runtime half: src/ runs in JavaScriptCore, whose surface is exactly what src/engine.d.ts declares.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Not "DOM": redjs is not a browser; lib.dom would type `globalThis.document` as a real Document.
    "lib": ["ESNext"],
    // `false` keeps a bare `x: T` declaration erased instead of a define that runs after `super()` and
    // clobbers a field a base constructor set. Bun reads this key too.
    "useDefineForClassFields": false,
    // No @types package may add a global that type-checks but does not exist at runtime.
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
