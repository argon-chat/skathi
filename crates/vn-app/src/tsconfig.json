{
  // Type-checks the two host preludes only (`bun x tsc --noEmit -p crates/vn-app/src`); they are
  // compiled into the binary as strings, not part of the runtime package. Nothing is emitted.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Not DOM: lib.dom would make `screen`, `matchMedia` etc. already exist and hide what the
    // prelude installs.
    "lib": ["ESNext"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // A class added later must not get a constructor prologue that runs before the host wires its globals.
    "useDefineForClassFields": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    // Not `isolatedModules`: the preludes are classic scripts (no import/export).
    // `types: []` so no @types package puts a global in scope that does not exist at runtime.
    "types": []
  },
  "include": [
    "prelude.ts",
    "window.prelude.ts",
    "prelude-host.d.ts",
    // What redjs provides, and the `__VN_*` contract the runtime consumes.
    "../../../packages/vue-native/src/engine.d.ts",
    "../../../packages/vue-native/src/protocol.d.ts"
  ]
}
