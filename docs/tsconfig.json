{
  "extends": ["astro/tsconfigs/strictest", "../tsconfig.base.json"],
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["astro/client", "bun"],
    "paths": { "@/*": ["./src/*"] },
    "jsx": "preserve",
    "jsxImportSource": "vue"
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", ".wrangler", "samples"]
}
