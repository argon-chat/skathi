---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import favicon from "../../../logos/logo_single.svg?url";

interface Props {
  title: string;
  description: string;
  canonical: URL;
  type: "website" | "article";
  structuredData: Record<string, unknown>;
  markdownUrl?: string | undefined;
  noindex?: boolean;
}

const { title, description, canonical, type, structuredData, markdownUrl, noindex = false } = Astro.props;
const image = new URL("/social.png", Astro.site);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#17161e" />
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" type="image/svg+xml" href={favicon} />
<Font cssVariable="--font-body" preload />
<Font cssVariable="--font-heading" preload />
<Font cssVariable="--font-code" preload />
<ClientRouter fallback="swap" />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="text/plain" title="Skathi documentation for agents" href="/llms.txt" />
{markdownUrl && <link rel="alternate" type="text/markdown" title={`${title} as Markdown`} href={markdownUrl} />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Skathi" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<script type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")} />
<script is:inline>
  try {
    const saved = localStorage.getItem("skathi-theme");
    document.documentElement.dataset.theme =
      saved === "light" || saved === "dark"
        ? saved
        : matchMedia("(prefers-color-scheme: light)").matches
          ? "light"
          : "dark";
  } catch {}
</script>
