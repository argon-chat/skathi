---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import favicon from "../../../logos/logo_single.svg?url";
import { blogFeed, blogTitle } from "../lib/blog";
import { siteGraph, type Thing } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  canonical: URL;
  type: "website" | "article";
  /** The page's own schema.org nodes; the organization and the website are added to the graph. */
  structuredData: Thing | Thing[];
  markdownUrl?: string | undefined;
  noindex?: boolean;
}

const { title, description, canonical, type, structuredData, markdownUrl, noindex = false } = Astro.props;
const site = Astro.site ?? new URL("https://skathi.land/");
const image = new URL("/social.png", site);
const graph = {
  "@context": "https://schema.org",
  "@graph": [...siteGraph(site), ...[structuredData].flat()].map(({ "@context": _, ...node }) => node),
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#17161e" />
<meta name="robots" content={noindex ? "noindex" : "max-image-preview:large, max-snippet:-1"} />
<link rel="icon" type="image/svg+xml" href={favicon} />
<Font cssVariable="--font-body" preload />
<Font cssVariable="--font-heading" preload />
<Font cssVariable="--font-code" preload />
<ClientRouter fallback="swap" />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="text/plain" title="Skathi documentation for agents" href="/llms.txt" />
<link rel="alternate" type="application/rss+xml" title={blogTitle} href={blogFeed} />
{markdownUrl && <link rel="alternate" type="text/markdown" title={`${title} as Markdown`} href={markdownUrl} />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Skathi" />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Skathi: desktop apps from Vue and Svelte, without a browser" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<script type="application/ld+json" set:html={JSON.stringify(graph).replaceAll("<", "\\u003c")} />
<script is:inline>
  try {
    const saved = localStorage.getItem("skathi-theme");
    document.documentElement.dataset.theme =
      saved === "light" || saved === "dark"
        ? saved
        : matchMedia("(prefers-color-scheme: light)").matches
          ? "light"
          : "dark";
    if (localStorage.getItem("skathi-framework") === "svelte") document.documentElement.dataset.framework = "svelte";
    const os = localStorage.getItem("skathi-os");
    document.documentElement.dataset.os =
      os === "windows" || os === "unix" ? os : /win/i.test(navigator.platform) ? "windows" : "unix";
  } catch {}
</script>
