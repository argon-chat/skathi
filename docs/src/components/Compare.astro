---
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";

interface Props {
  /** Shown left of the divider. Both images must have the same pixel size. */
  before: ImageMetadata;
  /** Shown right of the divider. */
  after: ImageMetadata;
  /** What the pair shows, for screen readers. */
  alt: string;
  beforeLabel?: string;
  afterLabel?: string;
  caption?: string;
  /** Where the divider starts, in percent from the left. */
  start?: number;
  /** Keep hard pixel edges when the pair is a zoomed crop. */
  pixelated?: boolean;
  /**
   * A lens under the pointer that shows the same spot of both images side by side, each source
   * pixel drawn this many CSS pixels wide. 0 turns it off.
   */
  loupe?: number;
  /**
   * A region of the images, in their own pixels, shown enlarged under the pair for both images.
   * It needs no pointer, so it is what a reader on a phone sees.
   */
  detail?: { x: number; y: number; width: number; height: number };
}

const {
  before,
  after,
  alt,
  beforeLabel = "Before",
  afterLabel = "After",
  caption,
  start = 50,
  pixelated = false,
  loupe = 0,
  detail,
} = Astro.props;
const widths = [Math.round(before.width / 2), before.width];
const sizes = "(max-width: 1250px) 100vw, 1000px";

// Enlarged pixels come from the untouched image: a lossy copy would show its own artefacts.
const exact = loupe > 0 || detail;
const beforeExact = exact ? (await getImage({ src: before, format: "png" })).src : "";
const afterExact = exact ? (await getImage({ src: after, format: "png" })).src : "";

const percent = (part: number, whole: number) => `${(part / whole) * 100}%`;
const detailPane = (src: string) =>
  detail &&
  [
    `background-image: url("${src}")`,
    `background-size: ${percent(before.width, detail.width)} ${percent(before.height, detail.height)}`,
    `background-position: ${percent(detail.x, Math.max(1, before.width - detail.width))} ${percent(detail.y, Math.max(1, before.height - detail.height))}`,
    `aspect-ratio: ${detail.width} / ${detail.height}`,
  ].join("; ");
const marker =
  detail &&
  [
    `left: ${percent(detail.x, before.width)}`,
    `top: ${percent(detail.y, before.height)}`,
    `width: ${percent(detail.width, before.width)}`,
    `height: ${percent(detail.height, before.height)}`,
  ].join("; ");
---

<figure class="demo compare" class:list={{ pixelated }}>
  <div
    class="demo-frame compare-frame"
    data-rail-bend
    style={`--at: ${start}%`}
    data-loupe={loupe > 0 ? loupe : undefined}
    data-width={before.width}
    data-height={before.height}
  >
    <Image src={after} alt={alt} widths={widths} sizes={sizes} format="webp" quality={95} />
    <Image class="compare-before" src={before} alt="" widths={widths} sizes={sizes} format="webp" quality={95} />
    <span class="compare-label compare-label-before" aria-hidden="true">{beforeLabel}</span>
    <span class="compare-label compare-label-after" aria-hidden="true">{afterLabel}</span>
    {marker && <span class="compare-marker" style={marker} aria-hidden="true" />}
    <span class="compare-divider" aria-hidden="true">
      <span class="compare-handle">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M6 4 2.5 8 6 12M10 4l3.5 4-3.5 4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </span>
    <input
      type="range"
      min="0"
      max="100"
      step="0.1"
      value={start}
      aria-label={`${beforeLabel} and ${afterLabel}: position of the divider`}
      data-compare
    />
    {
      loupe > 0 && (
        <span class="compare-loupe" aria-hidden="true" hidden>
          <span class="compare-loupe-pane" style={`background-image: url("${beforeExact}")`} />
          <span class="compare-loupe-pane" style={`background-image: url("${afterExact}")`} />
        </span>
      )
    }
  </div>
  {
    detail && (
      <div class="compare-detail" aria-hidden="true">
        <div class="compare-detail-pane">
          <span class="compare-detail-pixels" style={detailPane(beforeExact)} />
          <span class="compare-detail-label">{beforeLabel}</span>
        </div>
        <div class="compare-detail-pane">
          <span class="compare-detail-pixels" style={detailPane(afterExact)} />
          <span class="compare-detail-label">{afterLabel}</span>
        </div>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .compare-frame {
    position: relative;
    touch-action: pan-y;
    user-select: none;
  }
  .compare-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }
  .pixelated .compare-frame :global(img) {
    image-rendering: pixelated;
  }
  .compare-frame :global(.compare-before) {
    position: absolute;
    inset: 0;
    height: 100%;
    clip-path: inset(0 calc(100% - var(--at)) 0 0);
  }
  .compare-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--at);
    width: 1px;
    background: var(--text);
    opacity: 0.7;
    pointer-events: none;
  }
  .compare-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    translate: -50% -50%;
    box-shadow: var(--lift);
  }
  .compare-label,
  .compare-detail-label {
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    font-family: var(--font-code);
    font-size: var(--fs-xs);
    color: var(--muted);
    pointer-events: none;
  }
  .compare-label {
    position: absolute;
    top: 10px;
  }
  .compare-label-before {
    left: 10px;
  }
  .compare-label-after {
    right: 10px;
  }
  .compare-marker {
    position: absolute;
    border: 1px solid var(--accent);
    border-radius: 3px;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.45);
    pointer-events: none;
  }
  .compare-frame input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .compare-frame:has(input:focus-visible) .compare-handle {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .compare-loupe {
    position: absolute;
    left: var(--lx);
    top: var(--ly);
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    width: 321px;
    height: 168px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--text);
    box-shadow: var(--lift);
    pointer-events: none;
  }
  .compare-loupe[hidden] {
    display: none;
  }
  .compare-loupe-pane,
  .compare-detail-pixels {
    display: block;
    background-color: var(--surface);
    background-repeat: no-repeat;
    image-rendering: pixelated;
  }
  .compare-loupe-pane {
    background-size: var(--bw) var(--bh);
    background-position: var(--bx) var(--by);
  }

  .compare-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 12px;
  }
  .compare-detail-pane {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .compare-detail-pixels {
    width: 100%;
  }
  .compare-detail-label {
    position: absolute;
    left: 8px;
    bottom: 8px;
  }
</style>

<script>
  // Delegated: pages are swapped in by the client router.
  const slider = (target: EventTarget | null) =>
    target instanceof HTMLInputElement && target.matches("input[data-compare]") ? target : null;
  const place = (input: HTMLInputElement, percent: number) => {
    input.value = String(percent);
    input.parentElement?.style.setProperty("--at", `${percent}%`);
  };

  const LENS = { width: 321, height: 168, gap: 14 };
  function lens(input: HTMLInputElement, e: PointerEvent | null) {
    const frame = input.parentElement;
    const loupe = frame?.querySelector<HTMLElement>(".compare-loupe");
    if (!frame || !loupe) return;
    const zoom = Number(frame.dataset["loupe"]);
    if (!e || e.pointerType !== "mouse" || !(zoom > 0)) {
      loupe.hidden = true;
      return;
    }
    const box = input.getBoundingClientRect();
    const x = e.clientX - box.left;
    const y = e.clientY - box.top;
    const width = Number(frame.dataset["width"]);
    const height = Number(frame.dataset["height"]);
    const pane = (LENS.width - 1) / 2;
    // Each pane is centred on the source pixel under the pointer.
    loupe.style.setProperty("--bw", `${width * zoom}px`);
    loupe.style.setProperty("--bh", `${height * zoom}px`);
    loupe.style.setProperty("--bx", `${pane / 2 - (x / box.width) * width * zoom}px`);
    loupe.style.setProperty("--by", `${LENS.height / 2 - (y / box.height) * height * zoom}px`);
    const left = Math.min(Math.max(x - LENS.width / 2, 4), box.width - LENS.width - 4);
    const above = y - LENS.height - LENS.gap;
    loupe.style.setProperty("--lx", `${left}px`);
    loupe.style.setProperty("--ly", `${above >= 4 ? above : y + LENS.gap}px`);
    loupe.hidden = false;
  }

  // The pointer sets the divider under itself; a range thumb's travel is inset by half its width.
  const follow = (e: PointerEvent) => {
    const input = slider(e.target);
    if (!input) return;
    lens(input, e);
    if (e.type === "pointermove" && !input.hasPointerCapture(e.pointerId)) return;
    if (e.type === "pointerdown") {
      // Keeps the range from also dragging its own thumb.
      e.preventDefault();
      input.focus({ preventScroll: true });
      input.setPointerCapture(e.pointerId);
    }
    const box = input.getBoundingClientRect();
    place(input, Math.min(100, Math.max(0, ((e.clientX - box.left) / box.width) * 100)));
  };
  document.addEventListener("pointerdown", follow);
  document.addEventListener("pointermove", follow);
  document.addEventListener(
    "pointerout",
    (e) => {
      const input = slider(e.target);
      if (input) lens(input, null);
    },
    true,
  );
  document.addEventListener("input", (e) => {
    const input = slider(e.target);
    if (input) place(input, Number(input.value));
  });
</script>
