---
import Icon from "../Icon.astro";

interface Props {
  title?: string;
  /** One line under the title: who has to act. */
  summary?: string;
}

const { title = "Breaking changes", summary } = Astro.props;
---

<section class="migration" aria-label={title}>
  <div class="migration-head">
    <span class="migration-icon"><Icon name="alert" size={17} /></span>
    <p>
      <strong>{title}</strong>
      {summary && <span>{summary}</span>}
    </p>
  </div>
  <ol class="migration-list">
    <slot />
  </ol>
</section>
