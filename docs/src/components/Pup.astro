---
import "../styles/pup.css";
import still from "../assets/pup/pup.png?url";
import animated from "../assets/pup/pup.webp?url";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["pup", className]} aria-hidden="true" data-pup>
  <picture class="pup-body">
    <source media="(prefers-reduced-motion: reduce)" srcset={still} />
    <source type="image/webp" srcset={animated} />
    <img src={still} width="75" height="75" alt="" loading="lazy" decoding="async" draggable="false" />
  </picture>
  <svg class="pup-heart" viewBox="0 0 7 6" shape-rendering="crispEdges">
    <path d="M1 0h2v1H1zM4 0h2v1H4zM0 1h7v2H0zM1 3h5v1H1zM2 4h3v1H2zM3 5h1v1H3z"></path>
  </svg>
</div>
