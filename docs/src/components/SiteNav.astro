---
import "../styles/site.css";
import wolf from "../../../logos/logo_single.svg?url";
import Icon from "./Icon.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
import { docsHome, repository } from "../lib/docs";
import { blogHome } from "../lib/blog";

interface Props {
  /** The blog page this is: the index is the current page, a post is inside the blog. */
  blog?: "index" | "post";
}

const { blog } = Astro.props;
---

<header class="site-nav">
  <a class="site-mark" href="/" aria-label="Skathi home">
    <img src={wolf} width="34" height="34" alt="" /><span>Skathi</span>
  </a>
  <nav class="site-links" aria-label="Site">
    <a href={docsHome}>Docs</a>
    <a href={blogHome} aria-current={blog === "index" ? "page" : blog === "post" ? "true" : undefined}>Blog</a>
    <a href="/quick-start/" class="wide-only">Quick start</a>
    <a href="/css/" class="wide-only">CSS</a>
    <a href={repository} target="_blank" rel="noreferrer" aria-label="Skathi on GitHub"
      ><Icon name="github" size={19} /></a
    >
    <ThemeSwitch />
  </nav>
</header>
