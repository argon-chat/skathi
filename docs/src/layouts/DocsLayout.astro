---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import "../styles/docs.css";
import Brand from "../components/Brand.astro";
import Head from "../components/Head.astro";
import Icon from "../components/Icon.astro";
import PageActions from "../components/PageActions.vue";
import Parallax from "../components/Parallax.astro";
import Pup from "../components/Pup.astro";
import Search from "../components/Search.vue";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import { blogHome } from "../lib/blog";
import { docsHome, getDocs, markdownUrl, pageUrl, repository, sections, statusLabels, version } from "../lib/docs";

interface Link {
  label: string;
  href: string;
}

interface Props {
  page?: CollectionEntry<"docs">;
  headings?: MarkdownHeading[];
  title?: string;
  description?: string;
  /** A page outside the content collection: the sidebar entry it belongs under, and its own trail and links. */
  sub?: {
    parent: string;
    path: string;
    trail: Link[];
    markdown: string;
    edit: string;
    previous?: Link | undefined;
    next?: Link | undefined;
  };
}

const {
  page,
  headings = [],
  sub,
  title = page?.data.title ?? "Page not found",
  description = page?.data.description ?? "Find your way back to the Skathi documentation.",
} = Astro.props;
const pages = await getDocs();
const parent = sub ? pages.find((entry) => entry.id === sub.parent) : undefined;
const navId = page?.id ?? parent?.id;
const current = pages.findIndex((entry) => entry.id === page?.id);
const previousPage = pages[current - 1];
const nextPage = current >= 0 ? pages[current + 1] : undefined;
const toLink = (entry: CollectionEntry<"docs"> | undefined): Link | undefined =>
  entry && { label: entry.data.label ?? entry.data.title, href: pageUrl(entry.id) };
const previous = sub ? sub.previous : toLink(previousPage);
const next = sub ? sub.next : toLink(nextPage);
const markdownHref = sub?.markdown ?? (page && markdownUrl(page.id));
const editHref =
  sub?.edit ??
  (page &&
    `${repository}/edit/master/docs/${page.filePath?.replace(/^.*[\\/]docs[\\/]/, "").replaceAll("\\", "/") ?? ""}`);
const trail: Link[] = sub
  ? sub.trail
  : page
    ? [{ label: page.data.label ?? title, href: pageUrl(page.id) }]
    : [{ label: title, href: "/404/" }];
const section = page?.data.section ?? parent?.data.section ?? "Navigation";
const indexable = Boolean(page || sub);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const canonical = new URL(sub?.path ?? (page ? pageUrl(page.id) : "/404/"), Astro.site);
const sectionIcons = {
  "Getting started": "book",
  Guides: "monitor",
  Devtools: "terminal",
  Embedding: "package",
  Reference: "layers",
  Contributing: "code",
} as const;
const status = page?.data.status;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description,
  url: canonical.href,
  inLanguage: "en",
  isPartOf: { "@type": "WebSite", name: "Skathi documentation", url: Astro.site?.href },
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <Head
      title={`${title} · Skathi`}
      description={description}
      canonical={canonical}
      type="article"
      structuredData={structuredData}
      markdownUrl={markdownHref}
      noindex={!indexable}
    />
  </head>
  <body transition:animate="none">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Parallax docs />
    <header class="mobile-header">
      <Brand />
      <div class="mobile-controls">
        <button id="mobile-search" class="icon-button" aria-label="Search documentation"><Icon name="search" /></button
        ><button
          id="menu-toggle"
          class="icon-button"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="sidebar"><Icon name="menu" /></button
        >
      </div>
    </header>
    <div id="nav-backdrop" class="nav-backdrop" hidden></div>
    <aside id="sidebar" class="sidebar" aria-label="Documentation navigation">
      <div class="sidebar-top">
        <Brand docs />
        <Search client:load />
        <div class="edition">
          <span class="status-dot"></span><span>Desktop SDK</span><span class="edition-tag">v{version}</span>
        </div>
      </div>
      <nav class="sidebar-nav">
        {
          sections.map((section) => (
            <details open class="nav-section">
              <summary>
                <>
                  <Icon name={sectionIcons[section]} size={17} />
                  <span>{section}</span>
                  <Icon name="chevron" size={12} class="section-chevron" />
                </>
              </summary>
              <ul>
                {pages
                  .filter((entry) => entry.data.section === section)
                  .map((entry) => (
                    <li>
                      <a
                        href={pageUrl(entry.id)}
                        aria-current={page?.id === entry.id ? "page" : navId === entry.id ? "true" : undefined}
                      >
                        {entry.data.label ?? entry.data.title}
                        {entry.data.status && (
                          <span class="nav-status" title={statusLabels[entry.data.status]}>
                            <Icon name="flask" size={12} />
                            <span class="sr-only">{statusLabels[entry.data.status]}</span>
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
              </ul>
            </details>
          ))
        }
      </nav>
      <div class="sidebar-pup"><Pup /></div>
      <div class="sidebar-bottom">
        <nav class="sidebar-links" aria-label="More from Skathi">
          <a class="sidebar-link" href={blogHome}
            ><Icon name="rss" size={17} /><span>The Skathi blog</span><Icon name="arrow" size={14} /></a
          ><a class="sidebar-link" href="/llms.txt"
            ><Icon name="terminal" size={17} /><span>Built for your agent, too</span><Icon name="arrow" size={14} /></a
          >
        </nav>
        <div class="sidebar-meta">
          <a href={repository} aria-label="Skathi on GitHub" target="_blank" rel="noreferrer"
            ><Icon name="github" size={19} /></a
          ><span>Vue. Truly native.</span><ThemeSwitch />
        </div>
      </div>
    </aside>
    <div class="docs-shell">
      <main id="main-content" class="main-content" tabindex="-1">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={docsHome}>Docs</a><Icon name="chevron" size={12} /><span>{section}</span>{
            trail.map((link, index) =>
              index === trail.length - 1 ? (
                <>
                  <Icon name="chevron" size={12} />
                  <span class="breadcrumb-current" aria-current="page">
                    {link.label}
                  </span>
                </>
              ) : (
                <>
                  <Icon name="chevron" size={12} />
                  <a href={link.href}>{link.label}</a>
                </>
              ),
            )
          }
        </nav>
        {
          Astro.slots.has("heading") ? (
            <div class="article-heading article-heading-custom">
              <slot name="heading" />
              {markdownHref && <PageActions client:load markdownUrl={markdownHref} />}
            </div>
          ) : (
            <div class="article-heading">
              {status ? (
                <div class="article-title">
                  <h1>{title}</h1>
                  <span class="page-status" data-status={status}>
                    <Icon name="flask" size={15} />
                    {statusLabels[status]}
                  </span>
                </div>
              ) : (
                <h1>{title}</h1>
              )}
              {markdownHref && <PageActions client:load markdownUrl={markdownHref} />}
            </div>
          )
        }
        <article class="prose">
          <slot />
        </article>
        {
          indexable && (
            <footer class="article-footer">
              <div class="page-meta">
                <>
                  <a href={editHref} target="_blank" rel="noreferrer">
                    <Icon name="code" size={16} />
                    Edit this page
                    <Icon name="arrow" size={12} />
                  </a>
                  <span>Made with Vue. Rendered natively.</span>
                </>
              </div>
              <nav class="pagination" aria-label="Previous and next pages">
                {previous ? (
                  <a href={previous.href} class="previous-page">
                    <small>Previous</small>
                    <span>
                      <Icon name="chevron" size={14} />
                      {previous.label}
                    </span>
                  </a>
                ) : (
                  <span />
                )}
                {next && (
                  <a href={next.href} class="next-page">
                    <small>Next</small>
                    <span>
                      {next.label}
                      <Icon name="chevron" size={14} />
                    </span>
                  </a>
                )}
              </nav>
            </footer>
          )
        }
        <div class="site-footer">
          <a href="/">Skathi</a><span>Native by nature.</span><a
            href={`${repository}/blob/master/LICENSE-MIT`}
            target="_blank"
            rel="noreferrer">MIT / Apache-2.0</a
          >
        </div>
      </main>
      <aside class="right-sidebar" aria-label="On this page">
        <nav class="toc">
          <p class="toc-title">On this page</p><a href="#main-content" class="toc-link is-active" data-toc-overview
            >Overview</a
          >{
            toc.map((heading) => (
              <a
                href={`#${heading.slug}`}
                class:list={["toc-link", { "toc-nested": heading.depth === 3 }]}
                data-toc-id={heading.slug}
              >
                {heading.text}
              </a>
            ))
          }
        </nav>
        <div class="right-resources">
          <p>Less friction. More native.</p><a href="/quick-start/"
            >Build your first app<Icon name="arrow" size={15} /></a
          ><a href={repository} target="_blank" rel="noreferrer">Explore the source<Icon name="arrow" size={15} /></a><a
            href="/llms.txt">Read with your agent<Icon name="terminal" size={15} /></a
          >
        </div>
        <a class="open-source" href={repository} target="_blank" rel="noreferrer"
          ><Icon name="heart" size={14} />Open source, all the way down.</a
        >
      </aside>
    </div>
    <script>
      import "../scripts/docs";
      import "../scripts/parallax";
      import "../scripts/pup";
    </script>
  </body>
</html>
