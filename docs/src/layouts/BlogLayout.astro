---
import "../styles/docs.css";
import "../styles/blog.css";
import Head from "../components/Head.astro";
import Parallax from "../components/Parallax.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  type: "website" | "article";
  structuredData: Record<string, unknown>;
  blog: "index" | "post";
  noindex?: boolean;
  image?: string | undefined;
}

const { title, description, path, type, structuredData, blog, noindex = false, image } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <Head
      title={title}
      description={description}
      canonical={new URL(path, Astro.site)}
      type={type}
      structuredData={structuredData}
      noindex={noindex}
      image={image}
    />
  </head>
  <body class="blog" transition:animate="none">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Parallax docs />
    <SiteNav blog={blog} />
    <slot />
    <SiteFooter class="blog-footer" />
    <script>
      import "../scripts/docs";
      import "../scripts/parallax";
      import "../scripts/pup";
    </script>
  </body>
</html>
