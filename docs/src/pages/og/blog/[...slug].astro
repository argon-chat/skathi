---
// The 1200×630 card a post shows in link previews. Only `astro dev` serves it: `bun scripts/og.ts`
// photographs it into public/og/blog/<id>.png, which the post's og:image points at.
import type { GetStaticPaths } from "astro";
import { Font } from "astro:assets";
import wolf from "../../../../../logos/logo_single.svg?url";
import "../../../styles/docs.css";
import "../../../styles/parallax.css";
import { formatDate, getPosts, type Post } from "../../../lib/blog";

export const getStaticPaths = (async () =>
  import.meta.env.DEV
    ? (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }))
    : []) satisfies GetStaticPaths;

const { post } = Astro.props as { post: Post };
const { title: heading, metaTitle, description, date, tags, release } = post.data;
const title = metaTitle ?? heading;
const label = release ? `Release ${release.version}` : (tags[0] ?? "Blog");
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-heading" preload />
    <Font cssVariable="--font-code" preload />
    <title>{title}</title>
  </head>
  <body>
    <main class="card">
      <span class="glow glow-pink"></span>
      <span class="glow glow-blue"></span>
      <img class="wolf" src={wolf} width="420" height="420" alt="" />
      <header>
        <img src={wolf} width="44" height="44" alt="" /><span>Skathi blog</span>
      </header>
      <div class="body">
        <h1>{title}</h1>
        <p>{description}</p>
      </div>
      <footer>
        <span class="label">{label}</span>
        <span>{formatDate(date)} · skathi.land</span>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  astro-dev-toolbar {
    display: none !important;
  }
</style>

<style>
  html,
  body {
    margin: 0;
    background: var(--bg);
  }
  .card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: 1200px;
    height: 630px;
    padding: 56px 72px 48px;
    color: var(--text);
    font-family: var(--font-body);
    background:
      radial-gradient(ellipse at 50% -20%, color-mix(in srgb, var(--candy-lilac) 16%, transparent), transparent 60%),
      var(--bg);
  }
  .glow {
    position: absolute;
    width: 640px;
    height: 520px;
    background: radial-gradient(closest-side, var(--glow) 20%, transparent);
    opacity: 0.22;
  }
  .glow-pink {
    --glow: var(--candy-pink);
    left: -220px;
    bottom: -260px;
  }
  .glow-blue {
    --glow: var(--candy-blue);
    right: -200px;
    top: -240px;
  }
  .wolf {
    position: absolute;
    right: -90px;
    top: -40px;
    opacity: 0.12;
    transform: rotate(-8deg);
  }
  header {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 26px;
    font-weight: 650;
  }
  .body {
    position: relative;
    margin-top: auto;
    max-width: 1056px;
  }
  h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 60px;
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .body p {
    margin: 22px 0 0;
    color: var(--muted);
    font-size: 27px;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  footer {
    position: relative;
    display: flex;
    justify-content: space-between;
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--font-code);
    font-size: 21px;
  }
  .label {
    color: var(--candy-lilac);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
