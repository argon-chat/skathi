---
import { render, type CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import "../styles/reference.css";
import CheckCatalog from "../components/reference/CheckCatalog.astro";
import ConfigReference from "../components/reference/ConfigReference.astro";
import RefCatalog from "../components/reference/RefCatalog.vue";
import DocsLayout from "../layouts/DocsLayout.astro";
import { checkGroups, checkPage } from "../lib/check";
import { configHeadings, configPage } from "../lib/config";
import { getDocs, type TocHeading } from "../lib/docs";
import { catalogEntries, categoryId, inline, kindLabel } from "../lib/reference";
import { references } from "../lib/references";
import { currentMinor, isNew } from "../lib/release";

export const getStaticPaths = (async () =>
  (await getDocs()).map((page) => ({
    params: { slug: page.id },
    props: { page },
  }))) satisfies GetStaticPaths;

interface Props {
  page: CollectionEntry<"docs">;
}

const { page } = Astro.props;
const { Content, headings: rendered, remarkPluginFrontmatter } = await render(page);
const sectionSince = (remarkPluginFrontmatter["sectionSince"] ?? {}) as Record<string, string>;
const headings: TocHeading[] = rendered.map((heading) => ({ ...heading, fresh: isNew(sectionSince[heading.text]) }));
const reference = references[page.id];
const catalog = reference ? catalogEntries(reference) : [];
const notes = reference
  ? Object.fromEntries(
      Object.entries(reference.categoryNotes).map(([category, note]) => [category, inline(note ?? "")]),
    )
  : {};
const kinds = Object.fromEntries(catalog.map((entry) => [entry.kind, kindLabel(entry.kind)]));
const toc: TocHeading[] = reference
  ? [
      ...headings.filter((heading) => heading.depth === 2),
      ...reference.categories.map((category) => ({ depth: 2, slug: categoryId(category), text: category })),
    ]
  : page.id === configPage.id
    ? [...headings, ...configHeadings]
    : page.id === checkPage.id
      ? [
          ...headings,
          ...checkGroups.map((group) => ({ depth: 2, slug: group.id, text: `${group.label}: ${group.title}` })),
          { depth: 2, slug: "retired-codes", text: "Retired codes" },
        ]
      : headings;
---

<DocsLayout page={page} headings={toc}>
  <Content />
  {page.id === configPage.id && <ConfigReference />}
  {page.id === checkPage.id && <CheckCatalog />}
  {
    reference && (
      <RefCatalog
        client:load
        entries={catalog}
        categories={[...reference.categories]}
        notes={notes}
        kinds={kinds}
        base={`/${reference.id}/`}
        noun={reference.noun}
        current={currentMinor}
      />
    )
  }
</DocsLayout>
