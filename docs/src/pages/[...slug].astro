---
import { render, type CollectionEntry } from "astro:content";
import type { GetStaticPaths, MarkdownHeading } from "astro";
import "../styles/reference.css";
import RefCatalog from "../components/reference/RefCatalog.vue";
import DocsLayout from "../layouts/DocsLayout.astro";
import { getDocs } from "../lib/docs";
import { catalogEntries, categoryId, currentVersion, inline, kindLabel } from "../lib/reference";
import { references } from "../lib/references";

export const getStaticPaths = (async () =>
  (await getDocs()).map((page) => ({
    params: { slug: page.id },
    props: { page },
  }))) satisfies GetStaticPaths;

interface Props {
  page: CollectionEntry<"docs">;
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const reference = references[page.id];
const catalog = reference ? catalogEntries(reference) : [];
const notes = reference
  ? Object.fromEntries(Object.entries(reference.categoryNotes).map(([category, note]) => [category, inline(note ?? "")]))
  : {};
const kinds = Object.fromEntries(catalog.map((entry) => [entry.kind, kindLabel(entry.kind)]));
const toc: MarkdownHeading[] = reference
  ? [
      ...headings.filter((heading) => heading.depth === 2),
      ...reference.categories.map((category) => ({ depth: 2, slug: categoryId(category), text: category })),
    ]
  : headings;
---

<DocsLayout page={page} headings={toc}>
  <Content />
  {
    reference && (
      <RefCatalog
        client:load
        entries={catalog}
        categories={[...reference.categories]}
        notes={notes}
        kinds={kinds}
        base={`/${reference.id}/`}
        noun={reference.noun}
        current={currentVersion}
      />
    )
  }
</DocsLayout>
