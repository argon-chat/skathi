---
import type { GetStaticPaths } from "astro";
import EntryPage from "../../components/reference/EntryPage.astro";
import { ordered, type RefEntry } from "../../lib/reference";
import { windowReference } from "../../lib/window";

export const getStaticPaths = (() => {
  const all = ordered(windowReference);
  return all.map((entry, index) => ({
    params: { slug: entry.slug },
    props: { entry, previous: all[index - 1], next: all[index + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: RefEntry;
  previous?: RefEntry | undefined;
  next?: RefEntry | undefined;
}

const { entry, previous, next } = Astro.props;
---

<EntryPage reference={windowReference} entry={entry} previous={previous} next={next} />
