---
import { Image } from "astro:assets";
import { Code } from "astro:components";
import "../styles/docs.css";
import "../styles/landing.css";
import wordmark from "../../../logos/full_side_text_logo.svg?url";
import wolf from "../../../logos/logo_single.svg?url";
import shadingGlass from "../assets/shading-glass.png";
import shadingNebula from "../assets/shading-nebula.png";
import slang from "../lib/slang";
import Head from "../components/Head.astro";
import Icon from "../components/Icon.astro";
import Parallax from "../components/Parallax.astro";
import Pup from "../components/Pup.astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import { docsHome, repository, version } from "../lib/docs";
import { fetchStats } from "../lib/stats";

const command = "bun create skathi my-blazing-fast-app";
const title = "Skathi · Desktop apps from Vue, without a browser";
const description =
  "Write Vue 3 or Svelte 5 components in TypeScript. Skathi renders them on the GPU, runs the script in JavaScriptCore or compiles it ahead of time to machine code, and ships one app for Windows, macOS and Linux.";
const canonical = new URL("/", Astro.site);
const stats = await fetchStats();
const compact = new Intl.NumberFormat("en", { notation: "compact", maximumFractionDigits: 1 });

const component = `<script setup lang="ts">
import { ref } from "vue";

const count = ref(0);
</script>

<template>
  <main class="window">
    <h1>Hello from a native window</h1>
    <button @click="count++">
      Clicked {{ count }} times
    </button>
  </main>
</template>`;

const sheenShader = `[SkEffect("sheen")]
struct Sheen : IEffect
{
    [SkAnimated] [SkDefault("0.5")] [SkRange(0.0, 4.0)]
    float speed;

    [SkColor] [SkOptional] [SkDefault("#ffffff")]
    float4 tint;

    static override bool straightAlpha() { return true; }

    float4 shade(EffectInput input)
    {
        float sweep = frac(input.time * speed) * 1.6 - 0.3;
        float band = saturate(1.0 - abs((input.local.x + input.local.y) * 0.5 - sweep) * 8.0);
        return float4(tint.rgb, tint.a * band * band * 0.6);
    }
};`;

const sheenCss = `.card {
  background: linear-gradient(135deg, #3b3f9e, #8b5cf6);
  --shading: sheen(0.5, #ffffffcc);
  transition: --shading 600ms ease;
}
.card:hover {
  --shading: sheen(0.5, #ffd6f0);
}`;

const notesRust = `#[skathi::data]
#[derive(Clone)]
pub struct Note {
    pub id: u64,
    pub title: String,
}

#[derive(Default)]
pub struct Notes(std::sync::Mutex<Vec<Note>>);

#[skathi::module]
impl Notes {
    pub fn count(&self) -> u32 {
        self.0.lock().unwrap().len() as u32
    }

    #[task]
    pub fn search(&self, text: String) -> Vec<Note> {
        let notes = self.0.lock().unwrap();
        let found = notes.iter().filter(|n| n.title.contains(&text));
        found.cloned().collect()
    }
}

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let ui = skathi::Builder::new()
        .payload_file("app/dist/release/.sk/app.skpk")
        .module("notes", Notes::default())
        .spawn()?;
    ui.wait();
    Ok(())
}`;

const notesVue = `<script setup lang="ts">
import { ref, watch } from "vue";
import { count, search, type Note } from "native:notes";

const total = count();
const query = ref("");
const found = ref<Note[]>([]);

watch(query, async (text) => {
  found.value = await search(text);
});
</script>

<template>
  <input v-model="query" placeholder="Search notes" />
  <p>{{ found.length }} of {{ total }}</p>
  <p v-for="note in found" :key="note.id">{{ note.title }}</p>
</template>`;

const notesTypes = `declare module "native:notes" {
  export type Note = {
    id: number;
    title: string;
  };
  export const available: boolean;
  export function count(): number;
  export function search(text: string): Promise<Note[]>;
}`;

const calls = [
  {
    title: "add(a, b), one call",
    max: 932,
    rows: [
      { name: "Skathi", value: 0.06, label: "0.06 µs", how: "in the same process" },
      { name: "Electron", value: 109, label: "109 µs", how: "IPC to the main process" },
      { name: "Tauri 2", value: 932, label: "932 µs", how: "IPC to the app process" },
    ],
  },
  {
    title: "1 MiB of bytes into native code",
    max: 8.9,
    rows: [
      { name: "Skathi", value: 0.001, label: "<0.001 ms", how: "a &[u8], read in place" },
      { name: "Electron", value: 1.14, label: "1.14 ms", how: "a structured clone" },
      { name: "Tauri 2", value: 8.9, label: "8.9 ms", how: "an ArrayBuffer as a raw body" },
    ],
  },
] as const;

const builds = [
  { label: "Every default feature", size: 101.4, detail: "459 crates" },
  { label: "prod, types, storages, clipboard", size: 86.0, detail: "361 crates" },
  { label: "the same, plus icu-root and no-devtools", size: 75.2, detail: "root ICU locale, no inspector" },
] as const;

const held = [7, 7, 7, 7, 7, 7, 7, 6];
const frames = held.map((span, index) => ({
  span,
  start: held.slice(0, index).reduce((sum, refreshes) => sum + refreshes, 0),
}));
const refreshes = held.reduce((sum, refreshes) => sum + refreshes, 0);

const display = [
  { field: "headroom", text: "the brightest value the screen shows now; 1.0 is SDR white" },
  { field: "potentialHeadroom", text: "the brightest it can show; on a Mac, at full brightness" },
  { field: "sdrWhiteNits", text: "the SDR white the user picked, in Windows' HDR mode" },
  { field: "hdr", text: "Windows' HDR mode is on, or the Mac screen has EDR headroom" },
  { field: "refreshRate", text: "the screen's rate, in Hz" },
  { field: "variableRefresh", text: "ProMotion or Adaptive-Sync, on macOS" },
] as const;

const sources = [
  {
    platform: "Windows",
    paths: [
      "Direct3D 11",
      "Direct3D 12, with a fence",
      "shared handles from another device or process",
      "Vulkan, through a shared texture",
    ],
  },
  {
    platform: "macOS",
    paths: ["Metal", "IOSurfaces", "CVPixelBuffers from VideoToolbox, AVFoundation or ScreenCaptureKit"],
  },
  { platform: "Everywhere", paths: ["CPU BGRA and BGRX", "CPU half floats", "Linux: CPU frames"] },
] as const;

const effects = [
  "nebula",
  "lens",
  "glass",
  "ripples",
  "shatter",
  "snow",
  "fireflies",
  "dissolve",
  "orbit",
  "halftone",
  "pond",
  "spotlight",
  "grade",
  "sheen",
];

const features = [
  {
    icon: "cpu",
    tone: "pink",
    title: "Rendered on the GPU",
    text: "Layout by Taffy, painting by gpui on Direct3D, Metal or Vulkan. No WebView, and no Chromium in your bundle.",
  },
  {
    icon: "layers",
    tone: "lilac",
    title: "Vue 3 and Svelte 5",
    text: "Single-file components, the Composition API, Pinia, Vue Router and Tailwind. Or Svelte 5, from its own template.",
  },
  {
    icon: "braces",
    tone: "blue",
    title: "Web APIs, written in Rust",
    text: "Your script runs in JavaScriptCore. fetch, IndexedDB, Web Animations, Pointer Lock and View Transitions are native code.",
  },
  {
    icon: "refresh",
    tone: "yellow",
    title: "Hot reload and devtools",
    text: "Save a .vue, .ts or .css file and the window updates in place. F12 opens devtools with elements, performance and effects.",
  },
  {
    icon: "sparkle",
    tone: "pink",
    title: "GPU effects",
    text: "Write shaders in Slang and attach them to any element: liquid glass, ripples, snow, shatter, and cross-fades between them.",
  },
  {
    icon: "package",
    tone: "lilac",
    title: "One app to ship",
    text: "A single executable on Windows, an .app on macOS, an AppImage on Linux. Nothing else to install.",
  },
] as const;

const steps = [
  { label: "Create", command, text: "Pick a template: the showcase, a minimal app, or Svelte." },
  { label: "Develop", command: "bun run dev", text: "A native window opens and follows your edits." },
  { label: "Ship", command: "bun run publish", text: "A release build for this OS, ready to hand out." },
] as const;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Skathi",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Windows, macOS, Linux",
  softwareVersion: version,
  description,
  url: canonical.href,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <Head
      title={title}
      description={description}
      canonical={canonical}
      type="website"
      structuredData={structuredData}
    />
  </head>
  <body class="landing" transition:animate="none">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Parallax />
    <header class="landing-nav">
      <a class="landing-mark" href="/" aria-label="Skathi home">
        <img src={wolf} width="34" height="34" alt="" /><span>Skathi</span>
      </a>
      <nav class="landing-links" aria-label="Site">
        <a href={docsHome}>Docs</a>
        <a href="/quick-start/" class="wide-only">Quick start</a>
        <a href="/css/" class="wide-only">CSS</a>
        <a href={repository} target="_blank" rel="noreferrer" aria-label="Skathi on GitHub"
          ><Icon name="github" size={19} /></a
        >
        <ThemeSwitch />
      </nav>
    </header>

    <main id="main-content" tabindex="-1">
      <section class="hero">
        <div class="hero-art" aria-hidden="true">
          <span class="glow glow-pink"></span>
          <span class="glow glow-blue"></span>
        </div>
        <img class="hero-logo" src={wordmark} width="1902" height="827" alt="Skathi" />
        <p class="hero-meta">
          <span class="status-dot"></span>v{version}<span aria-hidden="true">·</span>Windows, macOS and Linux
        </p>
        <h1>Desktop apps from Vue, <span class="candy-text">without a browser.</span></h1>
        <p class="hero-lead">{description}</p>
        <div class="command">
          <span class="command-prompt" aria-hidden="true">$</span>
          <code>{command}</code>
          <button type="button" class="command-copy" data-copy={command} aria-label="Copy the command">
            <Icon name="copy" size={15} /><span data-copy-label>Copy</span>
          </button>
        </div>
        <div class="hero-actions">
          <a class="button button-primary" href="/quick-start/">Get started<Icon name="arrow" size={15} /></a>
          <a class="button" href={repository} target="_blank" rel="noreferrer"
            ><Icon name="github" size={16} />Star on GitHub</a
          >
        </div>
        <dl class="stats">
          <div data-stat-cell="npm" hidden={stats.npm === undefined}>
            <dt>installs from npm</dt>
            <dd data-stat="npm">{stats.npm !== undefined && compact.format(stats.npm)}</dd>
          </div>
          <div data-stat-cell="stars" hidden={stats.stars === undefined}>
            <dt>stars on GitHub</dt>
            <dd data-stat="stars">{stats.stars !== undefined && compact.format(stats.stars)}</dd>
          </div>
        </dl>
      </section>

      <section class="gallery" aria-labelledby="gallery-title" data-fan>
        <div class="gallery-stage">
          <h2 id="gallery-title" class="gallery-title">
            Two templates to start from. <span class="candy-text">Every pixel drawn by Skathi.</span>
          </h2>
          <div class="fan">
            <figure class="fan-card" style="--side: -1">
              <div class="window">
                <video
                  muted
                  loop
                  playsinline
                  preload="none"
                  width="1280"
                  height="820"
                  poster="/media/player-poster.webp"
                  aria-label="The player template: a radial spectrum round the cover, recolouring with each track, and hearts when a song is liked"
                >
                  <source data-src="/media/player.webm" type='video/webm; codecs="av01.0.05M.08"' />
                  <source data-src="/media/player.mp4" type="video/mp4" />
                </video>
              </div>
              <figcaption>
                <strong>Music player</strong><span>Svelte 5 · spectrum, aurora and glass in shaders</span>
                <code>bun create skathi my-app --template player</code>
              </figcaption>
            </figure>
            <figure class="fan-card" style="--side: 1">
              <div class="window">
                <video
                  muted
                  loop
                  playsinline
                  preload="none"
                  width="1280"
                  height="820"
                  poster="/media/weather-poster.webp"
                  aria-label="The weather template: rain over a painted valley, a thunderstorm with lightning, then snow, with drops and frost on the glass panels"
                >
                  <source data-src="/media/weather.webm" type='video/webm; codecs="av01.0.05M.08"' />
                  <source data-src="/media/weather.mp4" type="video/mp4" />
                </video>
              </div>
              <figcaption>
                <strong>Weather</strong><span>Vue 3 · sky, rain, lightning and frost in shaders</span>
                <code>bun create skathi my-app --template weather</code>
              </figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="code-demo" aria-labelledby="code-title">
        <div class="code-intro">
          <h2 id="code-title">Write a component. <span class="candy-text">Get a window.</span></h2>
          <p>
            It is the Vue you already write: <code>ref</code>, templates, scoped styles, Pinia stores. Skathi takes the
            tree Vue builds and draws it natively, so there is no DOM to ship and no browser to start.
          </p>
          <a class="text-link" href="/concepts/">How the runtime works<Icon name="arrow" size={14} /></a>
        </div>
        <div class="code-stage">
          <div class="code-panel">
            <span class="code-file">App.vue</span>
            <Code
              code={component}
              lang="vue"
              themes={{ light: "github-light", dark: "github-dark" }}
              defaultColor={false}
            />
          </div>
          <div class="mini-window" aria-label="What the component looks like">
            <div class="mini-titlebar">
              <img src={wolf} width="16" height="16" alt="" /><span>my-blazing-fast-app</span><span
                class="mini-controls"
                aria-hidden="true"><i></i><i></i><i></i></span
              >
            </div>
            <div class="mini-body">
              <strong>Hello from a native window</strong>
              <button type="button" data-counter>Clicked 0 times</button>
            </div>
          </div>
        </div>
      </section>

      <section class="shading" aria-labelledby="shading-title">
        <div class="shading-head">
          <p class="eyebrow eyebrow-pink"><Icon name="sparkle" size={15} />Shading</p>
          <h2 id="shading-title">Shaders, <span class="candy-text">straight from CSS.</span></h2>
          <p>
            An effect is one Slang file in <code>shaders/</code>. Skathi compiles it for Direct3D, Vulkan and Metal and
            hands it to CSS as a custom property: parameters are arguments, and a transition on
            <code>--shading</code> blends between them, or between two different effects.
          </p>
        </div>
        <div class="shading-grid">
          <div class="shading-code">
            <div class="code-panel">
              <span class="code-file">shaders/sheen.slang</span>
              <Code
                code={sheenShader}
                lang={slang}
                themes={{ light: "github-light", dark: "github-dark" }}
                defaultColor={false}
              />
            </div>
            <div class="code-panel">
              <span class="code-file">src/styles.css</span>
              <Code
                code={sheenCss}
                lang="css"
                themes={{ light: "github-light", dark: "github-dark" }}
                defaultColor={false}
              />
            </div>
          </div>
          <div class="shading-gallery">
            <figure>
              <Image
                src={shadingGlass}
                alt="A liquid glass lens refracting the word refraction and two coloured discs"
                widths={[480, 968]}
                sizes="(max-width: 900px) 100vw, 520px"
                format="webp"
              />
              <figcaption><code>lens</code> reads the backdrop: liquid glass that bends what is behind it</figcaption>
            </figure>
            <figure>
              <Image
                src={shadingNebula}
                alt="An animated blue and violet nebula with twinkling stars"
                widths={[480, 968]}
                sizes="(max-width: 900px) 100vw, 520px"
                format="webp"
              />
              <figcaption><code>nebula</code> is animated: domain-warped noise, redrawn every frame</figcaption>
            </figure>
            <ul class="shading-list">
              <li>On an element, behind it, or over the whole window</li>
              <li>The pointer, a clock, colours, lengths and textures as parameters</li>
              <li>Multi-pass and feedback effects</li>
              <li>An Effects panel in the devtools, with controls for every parameter</li>
            </ul>
            <p class="effect-chips" aria-label="Effects in the showcase template">
              {effects.map((name) => <code>{name}</code>)}
            </p>
          </div>
        </div>
      </section>

      <section class="aot" aria-labelledby="aot-title">
        <div class="aot-copy">
          <p class="eyebrow"><Icon name="cpu" size={15} />Ahead-of-time compilation</p>
          <h2 id="aot-title">Your TypeScript, <span class="candy-text">compiled to machine code.</span></h2>
          <p>
            A release build can skip the JavaScript engine's warm-up. <code>sk publish --aot</code> takes the production bundle
            through Bun's frontend into an intermediate representation, compiles that to native code, and stamps the image
            into the app. The host runs it instead of parsing and interpreting the bundle.
          </p>
          <p>
            The compiler does best with typed code. <code>sk check</code> lists what in your code and your dependencies would
            break or slow down under AOT, and how much of it is typed.
          </p>
          <p class="aot-note">
            Windows x64 for now, and experimental. Without <code>--aot</code>, the same app runs on JavaScriptCore.
          </p>
        </div>
        <ol class="pipeline" aria-label="How an AOT build is made">
          <li>
            <span class="pipeline-icon"><Icon name="code" size={18} /></span>
            <span><strong>Components and TypeScript</strong><small>.vue, .svelte, .ts</small></span>
          </li>
          <li>
            <span class="pipeline-icon"><Icon name="package" size={18} /></span>
            <span><strong>Production bundle</strong><small>tree-shaken, minified</small></span>
          </li>
          <li>
            <span class="pipeline-icon"><Icon name="layers" size={18} /></span>
            <span><strong>Intermediate representation</strong><small>Bun's AOT frontend</small></span>
          </li>
          <li>
            <span class="pipeline-icon"><Icon name="cpu" size={18} /></span>
            <span><strong>Machine code</strong><small>a native image inside the app</small></span>
          </li>
          <li class="pipeline-command"><code>$ bunx sk publish --aot</code></li>
        </ol>
      </section>

      <section class="embed" aria-labelledby="embed-title">
        <div class="embed-head">
          <h2 id="embed-title">Embed it in Rust. <span class="candy-text">Call Rust like a module.</span></h2>
          <p>
            The <code>skathi</code> crate runs the whole engine inside your executable, on a thread of its own, and
            <code>main</code> stays yours. Mark an <code>impl</code> block <code>#[skathi::module]</code> and the app imports
            its methods from <code>native:notes</code>: a <code>pub fn</code> returns its value inside the call, a
            <code>#[task]</code> runs on a worker and returns a promise, and events reach <code>on</code> from any thread.
          </p>
          <p>
            <code>sk types --exe</code> asks your exe for its modules and writes the app's <code>.d.ts</code>, so a
            renamed field fails the type check, not a user. Values cross straight between Rust and the engine with no
            JSON in between, and a <code>&amp;[u8]</code> reads the app's bytes where they are.
          </p>
          <p class="embed-links">
            <a class="text-link" href="/embedding/overview/">Embedding guide<Icon name="arrow" size={14} /></a>
            <a class="text-link" href="/embedding/native-modules/">Native modules<Icon name="arrow" size={14} /></a>
          </p>
        </div>

        <div class="embed-code">
          <div class="code-panel embed-rust">
            <span class="code-file">src/main.rs</span>
            <Code
              code={notesRust}
              lang="rust"
              themes={{ light: "github-light", dark: "github-dark" }}
              defaultColor={false}
            />
          </div>
          <div class="embed-app">
            <div class="code-panel">
              <span class="code-file">app/src/NoteSearch.vue</span>
              <Code
                code={notesVue}
                lang="vue"
                themes={{ light: "github-light", dark: "github-dark" }}
                defaultColor={false}
              />
            </div>
            <div class="code-panel embed-types">
              <span class="code-file"
                >app/src/native-modules.d.ts<span class="code-file-note">written by sk types --exe</span></span
              >
              <Code
                code={notesTypes}
                lang="ts"
                themes={{ light: "github-light", dark: "github-dark" }}
                defaultColor={false}
              />
            </div>
          </div>
        </div>

        <div class="embed-numbers">
          <figure class="calls">
            <figcaption>
              <h3>A call into native code, measured</h3>
              <p>
                The same app built three times, on one machine. Drawn to scale: Skathi's bars are a fraction of a pixel
                wide, so they show as a dot.
              </p>
            </figcaption>
            {
              calls.map((group) => (
                <dl class="call-group">
                  <dt class="call-title">
                    <code>{group.title}</code>
                  </dt>
                  {group.rows.map((row) => (
                    <dd class="call-row" data-ours={row.name === "Skathi" ? "" : undefined}>
                      <span class="call-name">{row.name}</span>
                      <span class="call-track" aria-hidden="true">
                        <span class="call-bar" style={`--share: ${(row.value / group.max) * 100}%`} />
                      </span>
                      <span class="call-value">
                        <strong>{row.label}</strong>
                        <small>{row.how}</small>
                      </span>
                    </dd>
                  ))}
                </dl>
              ))
            }
            <a class="text-link" href="/comparison/"
              >Skathi, Electron and Tauri side by side<Icon name="arrow" size={14} /></a
            >
          </figure>

          <figure class="builds">
            <figcaption>
              <h3>Only the features you use</h3>
              <p>
                Each subsystem is a Cargo feature. One that is off takes its crates out of the build and leaves the app
                a truthful answer: <code>navigator.gpu</code> is undefined, a <code>&lt;video&gt;</code> is an empty box that
                warns once.
              </p>
            </figcaption>
            <code class="builds-toml"
              >skathi = &#123; version = "0.4", default-features = false, features = ["prod", "types", "storages",
              "clipboard"] &#125;</code
            >
            <ul class="build-list">
              {
                builds.map((build) => (
                  <li>
                    <span class="build-label">{build.label}</span>
                    <span class="call-track" aria-hidden="true">
                      <span class="call-bar" style={`--share: ${(build.size / builds[0].size) * 100}%`} />
                    </span>
                    <span class="call-value">
                      <strong>{build.size.toFixed(1)} MB</strong>
                      <small>{build.detail}</small>
                    </span>
                  </li>
                ))
              }
            </ul>
            <p class="section-note">
              The exe of a minimal embedder, Windows x64, size profile. Native modules are new in 0.4.
            </p>
          </figure>
        </div>
      </section>

      <section class="surface" aria-labelledby="surface-title">
        <div class="surface-head">
          <h2 id="surface-title">
            Your renderer's frames, <span class="candy-text">composited into the UI.</span>
          </h2>
          <p>
            <code>&lt;sk-surface&gt;</code> shows what native code draws: a video player built on libmpv, a game engine's
            viewport, a renderer in another process. It is an ordinary element, so <code>object-fit</code>,
            <code>border-radius</code>, clipping, transforms, opacity and z-order apply, and your Vue or Svelte controls
            sit on top of it. No second window glued over the first.
          </p>
          <p>
            Your program presents frames by name, from the thread that renders. A present stores the frame and returns:
            nothing waits for the UI, and a frame no one can see costs no upload.
          </p>
          <a class="text-link" href="/embedding/native-frames/">Native frames<Icon name="arrow" size={14} /></a>
        </div>

        <div class="surface-stage">
          <figure class="player">
            <div class="player-window">
              <div class="mini-titlebar">
                <img src={wolf} width="16" height="16" alt="" /><span>player</span><span
                  class="mini-controls"
                  aria-hidden="true"><i></i><i></i><i></i></span
                >
              </div>
              <div class="player-body">
                <div
                  class="player-frame"
                  role="img"
                  aria-label="A frame from a native renderer, with rounded corners, under the app's playback controls"
                >
                  <img
                    class="player-picture"
                    src="/media/surface-preview.webp"
                    width="1440"
                    height="810"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                  <code class="player-tag">&lt;sk-surface name="player"&gt;</code>
                  <div class="player-controls" aria-hidden="true">
                    <span class="player-play"><Icon name="play" size={14} /></span>
                    <span class="player-time">0:42</span>
                    <span class="player-scrub"><span></span></span>
                    <span class="player-time">2:18</span>
                    <Icon name="volume" size={15} />
                  </div>
                </div>
              </div>
            </div>
            <figcaption>
              The frame comes from your renderer. The controls are Vue elements over it, and the rounded corners are
              <code>border-radius</code>.
            </figcaption>
          </figure>

          <div class="code-panel display-panel">
            <span class="code-file">@surfacedisplaychange</span>
            <dl>
              {
                display.map((item) => (
                  <div>
                    <dt>
                      <code>{item.field}</code>
                    </dt>
                    <dd>{item.text}</dd>
                  </div>
                ))
              }
            </dl>
            <p>
              The producer reads the same through <code>surface.info()</code>, with the last vblank and the refresh
              period. CSS <a href="/css/dynamic-range-limit/"><code>dynamic-range-limit</code></a> reaches it too:
              <code>content_headroom()</code> is how bright a frame should get.
            </p>
          </div>

          <figure class="timeline" style={`--refreshes: ${refreshes}`}>
            <figcaption>
              <h3>Presented, or Dropped and why</h3>
              <p>
                Every frame gets exactly one event, in order: <code>Presented</code> with the refresh it first showed on,
                or
                <code>Dropped</code> as <code>Superseded</code>, <code>Hidden</code>, <code>DeviceLost</code> or
                <code>Closed</code>. A player keeps its clock against the screen, and mpv's display-sync hears each real
                flip.
              </p>
            </figcaption>
            <div class="timeline-track" aria-hidden="true">
              <span class="timeline-ticks"></span>
              {
                frames.map((frame, index) => (
                  <span class="timeline-frame" style={`--start: ${frame.start}; --span: ${frame.span}`}>
                    <b>{index + 1}</b>
                    <small>{frame.span} refreshes</small>
                  </span>
                ))
              }
              <span class="timeline-head"></span>
            </div>
            <p class="timeline-note">
              24 fps on a 165 Hz screen, from Skathi's surface example: each frame <code>Presented</code>, held for 7,
              7, 7, 7, 7, 7, 7 and 6 refreshes.
            </p>
          </figure>
        </div>

        <div class="surface-facts">
          <div class="surface-sources">
            <h3>Frames from whatever renders them</h3>
            <p>On Windows and macOS a frame never leaves the GPU. The surface copies it and gives the texture back.</p>
            <dl>
              {
                sources.map((group) => (
                  <div>
                    <dt>{group.platform}</dt>
                    <dd>
                      {group.paths.map((path) => (
                        <span>{path}</span>
                      ))}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>
          <div class="surface-hdr">
            <h3>Half-float frames, shown in HDR.</h3>
            <div
              class="range"
              role="img"
              aria-label="Values from 0 to 1.0 show everywhere; values above 1.0 show up to the screen's headroom on an HDR display"
            >
              <span class="range-sdr">0 to 1.0: shown everywhere</span>
              <span class="range-hdr">above 1.0: up to the screen's headroom, on an HDR display</span>
            </div>
            <p>
              Set a surface to <code>Rgba16Float</code> and it takes FP16 frames in linear extended sRGB, from the CPU or
              the GPU. SDR content comes out exactly as on the 8-bit path. On an SDR screen highlights above SDR white
              clip.
            </p>
            <p>
              On an HDR display the window switches to HDR output while such a surface is visible, and highlights reach the
              screen's headroom, capped per element by <code>dynamic-range-limit</code>. The rest of the window stays at SDR
              white. A player that sizes its output to <code>content_headroom()</code> gets the right peak on both.
            </p>
            <p class="section-note">
              New in 0.4. GPU frames on Windows and macOS, CPU frames on Linux. HDR output on Windows and macOS; Linux
              windows stay SDR.
            </p>
          </div>
        </div>
      </section>

      <section class="features" aria-labelledby="features-title">
        <h2 id="features-title">Everything a desktop app needs, and nothing a browser brings.</h2>
        <div class="feature-grid">
          {
            features.map((feature) => (
              <article class="feature" data-tone={feature.tone}>
                <span class="feature-icon">
                  <Icon name={feature.icon} size={20} />
                </span>
                <h3>{feature.title}</h3>
                <p>{feature.text}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="steps" aria-labelledby="steps-title">
        <h2 id="steps-title">Three commands from idea to app.</h2>
        <ol class="step-list">
          {
            steps.map((step, index) => (
              <li class="step">
                <span class="step-number">{index + 1}</span>
                <h3>{step.label}</h3>
                <code class="step-command">{step.command}</code>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
        <p class="steps-more">
          Bringing an existing app over? Check the <a href="/css/">CSS coverage</a> and the <a href="/web-platform/"
            >web platform coverage</a
          > first.
        </p>
      </section>

      <section class="cta">
        <img src={wolf} width="96" height="96" alt="" class="cta-wolf" />
        <h2>Your next desktop app starts here.</h2>
        <div class="command">
          <span class="command-prompt" aria-hidden="true">$</span>
          <code>{command}</code>
          <button type="button" class="command-copy" data-copy={command} aria-label="Copy the command">
            <Icon name="copy" size={15} /><span data-copy-label>Copy</span>
          </button>
        </div>
      </section>
    </main>

    <footer class="site-footer landing-footer">
      <a href="/">Skathi</a><span>Native by nature.</span><a href="/llms.txt">llms.txt</a><a
        href={`${repository}/blob/master/LICENSE-MIT`}
        target="_blank"
        rel="noreferrer">MIT / Apache-2.0</a
      >
      <Pup class="landing-pup" />
    </footer>
    <script>
      import "../scripts/docs";
      import "../scripts/landing";
      import "../scripts/parallax";
      import "../scripts/pup";
    </script>
  </body>
</html>
