{
  // Code samples shown in the docs. `bun run check` in docs/ type-checks them like the apps.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "useDefineForClassFields": false,
    "baseUrl": ".",
    "paths": {
      "vue": ["../../packages/runtime/src/runtime.ts"],
      "@skathi-native/runtime": ["../../packages/runtime/src/runtime.ts"],
      "@skathi-native/runtime/svelte": ["../../packages/runtime/src/svelte.ts"]
    },
    "types": ["svelte"]
  },
  "vueCompilerOptions": { "lib": "@skathi-native/runtime" },
  "include": [
    "../../packages/runtime/src/engine.d.ts",
    "../../packages/runtime/src/protocol.d.ts",
    "../../packages/runtime/src/indexeddb.d.ts",
    "../../packages/runtime/env.d.ts",
    "**/*.ts",
    "**/*.vue",
    "**/*.svelte"
  ]
}
