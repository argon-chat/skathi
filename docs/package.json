{
  "name": "@skathi-native/docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:cloudflare": "wrangler dev",
    "check": "bun run api:check && astro check && vue-tsc --noEmit -p tsconfig.json && bun run check:samples && bun run bcd:check",
    "api:check": "bun scripts/bindings-reference.ts --check && bun test ./tests/bindings-reference.test.ts ./tests/rust-bindings.test.ts ./tests/css-api.test.ts ./tests/shader-api.test.ts",
    "bcd": "bun scripts/css-bcd.ts && bun scripts/web-bcd.ts",
    "bcd:check": "bun scripts/css-bcd.ts --check && bun scripts/web-bcd.ts --check",
    "check:layout": "astro build && bun scripts/check-layout.ts",
    "check:samples": "vue-tsc --noEmit -p samples/tsconfig.json && svelte-check --tsconfig ./samples/tsconfig.json --diagnostic-sources js,svelte --fail-on-warnings && vue-tsc --noEmit -p samples/tsconfig.specs.json",
    "test": "bun test tests/build.test.ts",
    "fmt": "bun fmt --no-script . && prettier --plugin prettier-plugin-astro --print-width 120 --write \"src/**/*.astro\"",
    "fmt:check": "bun fmt --no-script --check . && prettier --plugin prettier-plugin-astro --print-width 120 --check \"src/**/*.astro\"",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/sitemap": "^3.7.5",
    "@astrojs/vue": "^7.1.6",
    "@fontsource-variable/dm-sans": "^5",
    "@fontsource-variable/jetbrains-mono": "^5",
    "@fontsource-variable/lora": "^5",
    "@lezer/rust": "^1.0.3",
    "@shikijs/transformers": "^4.6.0",
    "astro": "^7.4.12",
    "satteri": "^0.11.7",
    "shiki": "^4.6.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@mdn/browser-compat-data": "8.1.10",
    "@resvg/resvg-wasm": "^2.6.2",
    "playwright-core": "^1.58.2",
    "prettier": "^3",
    "prettier-plugin-astro": "^0.14",
    "satori": "^0.63.2",
    "svelte-check": "^4",
    "wrangler": "^4.162.0"
  }
}
