#!/bin/sh
# Check staged Rust files with rustfmt and web files with Bun.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0
failed=0

rust=$(printf '%s\n' "$staged" | grep '\.rs$')
if [ -n "$rust" ]; then
  workspace_edition=$(sed -n '/^\[workspace\.package\]/,/^\[/s/^edition *= *"\([0-9]*\)".*/\1/p' Cargo.toml)
  unformatted=""
  for file in $rust; do
    dir=$(dirname "$file")
    while [ "$dir" != "." ] && [ ! -f "$dir/Cargo.toml" ]; do dir=$(dirname "$dir"); done
    edition=$(sed -n 's/^edition *= *"\([0-9]*\)".*/\1/p' "$dir/Cargo.toml" 2>/dev/null | head -n1)
    [ -n "$edition" ] || edition=$workspace_edition
    rustfmt --check --edition "$edition" "$file" >/dev/null 2>&1 || unformatted="$unformatted $file"
  done
  if [ -n "$unformatted" ]; then
    echo "Not formatted (run cargo fmt):" >&2
    printf '  %s\n' $unformatted >&2
    failed=1
  fi
fi

web=$(printf '%s\n' "$staged" | grep -E '\.(js|mjs|cjs|ts|mts|cts|tsx|jsx|vue|svelte|json|jsonc|css|scss|mdx?|ya?ml|html)$')
if [ -n "$web" ]; then
  if ! out=$(bun fmt --check $web 2>&1); then
    echo "Not formatted (run bun fmt):" >&2
    printf '%s\n' "$out" >&2
    failed=1
  fi
fi

# A reference entry gets its MDN link from generated data: a new entry needs the data made again.
if printf '%s\n' "$staged" | grep -qE '^docs/(src/data/(css|web)/(entries|bcd)\.ts|scripts/(css|web)-bcd\.ts)$'; then
  if ! out=$(bun run --cwd docs bcd:check 2>&1); then
    echo "MDN links of the reference are out of date (run bun run --cwd docs bcd):" >&2
    printf '%s\n' "$out" | grep -E 'no BCD key|Give each|out of date' >&2
    failed=1
  fi
fi

exit $failed
