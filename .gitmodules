[submodule "vendor/redjs"]
	path = vendor/redjs
	url = https://github.com/argon-chat/redjs.git
[submodule "vendor/taffy"]
	path = vendor/taffy
	url = https://github.com/argon-chat/taffy.git
	branch = vue-native
	shallow = true
[submodule "crates/vn-thorvg-sys/thorvg"]
	path = crates/sk-thorvg-sys/thorvg
	url = https://github.com/argon-chat/thorvg.git
	branch = vue-native
	shallow = true
[submodule "vendor/redslangc"]
	path = vendor/redslangc
	url = https://github.com/argon-chat/redslangc.git
[submodule "templates"]
	path = templates
	url = https://github.com/argon-chat/skathi-templates.git
[submodule "vendor/gpui"]
	path = vendor/gpui
	url = https://github.com/argon-chat/skathi-gpui.git
	branch = main
	shallow = true
